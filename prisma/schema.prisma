generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum Pick {
  HOME
  AWAY
  DRAW
  HOME_DRAW
  AWAY_DRAW
}

enum Currency {
  GOLD
  TIBIA_COINS
}

enum PvPBetStatus {
  OPEN
  MATCHED
  WON_CREATOR
  WON_ACCEPTOR
  CANCELLED
  VOID
}

enum TicketStatus {
  PENDING
  WON
  LOST
  VOID
}

enum SelectionResult {
  PENDING
  WON
  LOST
  VOID
}

enum HenricusFrameStatus {
  ACTIVE
  SETTLED
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String    @id @default(cuid())
  name            String?
  alias           String?   @unique
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now())
  saldoGold       Float     @default(0)
  saldoTibiaCoins Float     @default(0)

  // Double-or-nothing gamble state (slots). activeGambleAmount is the TC
  // currently "in play" on the gamble; 0 means no gamble pending.
  activeGambleAmount Float @default(0)
  activeGambleRounds Int   @default(0)

  // Soft-exclude from Wheel of Henricus pool. Keeps alias intact for other
  // features (Discord mentions, leaderboards) while removing them from spins
  // and the death-check cron.
  excludedFromWheel Boolean @default(false)

  // Set whenever the alias is (re)assigned. The Wheel of Henricus death cron
  // uses max(frame deathCutoff, aliasSetAt) per user so a player who joins
  // mid-round can't settle the frame with a death that happened before they
  // were on the wheel. Nullable for users who have never set an alias.
  aliasSetAt DateTime?

  accounts                 Account[]
  sessions                 Session[]
  createdBets              PvPBet[]          @relation("BetCreator")
  acceptedBets             PvPBet[]          @relation("BetAcceptor")
  tickets                  Ticket[]
  slotSpins                SlotSpin[]
  gambleRounds             SlotGambleRound[]
  henricusSpinsAsSpinner   HenricusSpin[]    @relation("HenricusSpinner")
  henricusSpinsAsAssigned  HenricusSpin[]    @relation("HenricusAssigned")
}

model Sport {
  id     String  @id @default(cuid())
  key    String  @unique // e.g. "basketball_nba"
  name   String // e.g. "NBA"
  active Boolean @default(true)
  events Event[]
}

model Event {
  id            String      @id @default(cuid())
  apiEventId    String      @unique
  sportId       String
  homeTeam      String
  awayTeam      String
  commenceTime  DateTime
  homeScore     Int?
  awayScore     Int?
  liveHomeScore Int?
  liveAwayScore Int?
  liveClock     String?
  status        EventStatus @default(UPCOMING)
  completedAt   DateTime?
  espnEventId   String?     @unique
  homeLogoUrl   String?
  awayLogoUrl   String?
  updatedAt     DateTime    @updatedAt

  sport      Sport             @relation(fields: [sportId], references: [id])
  odds       OddsSnapshot[]
  pvpBets    PvPBet[]
  selections TicketSelection[]

  @@index([status])
  @@index([commenceTime])
}

model OddsSnapshot {
  id           String   @id @default(cuid())
  eventId      String
  homeOdds     Float
  awayOdds     Float
  drawOdds     Float?
  homeDrawOdds Float?
  awayDrawOdds Float?
  bookmaker    String
  fetchedAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId, fetchedAt])
}

model PvPBet {
  id           String       @id @default(cuid())
  creatorId    String
  acceptorId   String?
  eventId      String
  pick         Pick
  amount       Float
  odds         Float
  joinerPick   Pick?
  joinerAmount Float?
  currency     Currency     @default(GOLD)
  status       PvPBetStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  settledAt    DateTime?

  creator  User  @relation("BetCreator", fields: [creatorId], references: [id])
  acceptor User? @relation("BetAcceptor", fields: [acceptorId], references: [id])
  event    Event @relation(fields: [eventId], references: [id])

  @@index([status])
  @@index([eventId])
}

model Ticket {
  id              String       @id @default(cuid())
  userId          String
  totalOdds       Float
  amount          Float
  currency        Currency     @default(GOLD)
  potentialPayout Float
  status          TicketStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  settledAt       DateTime?

  user       User              @relation(fields: [userId], references: [id])
  selections TicketSelection[]

  @@index([status])
  @@index([userId])
}

model TicketSelection {
  id       String          @id @default(cuid())
  ticketId String
  eventId  String
  pick     Pick
  odds     Float
  result   SelectionResult @default(PENDING)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id])

  @@index([ticketId])
  @@index([eventId])
}

model SlotSpin {
  id         String   @id @default(cuid())
  userId     String
  currency   Currency
  stake      Float
  payout     Float    @default(0) // 0 on loss
  symbols    String // e.g. "dragon,dragon,snake"
  multiplier Float    @default(0) // payout / stake; convenience for analytics
  isFreeSpin Boolean  @default(false) // true if this spin was awarded via the joker bonus
  createdAt  DateTime @default(now())

  user         User              @relation(fields: [userId], references: [id])
  gambleRounds SlotGambleRound[]

  @@index([userId])
  @@index([createdAt])
  @@index([multiplier])
}

// One row per double-or-nothing round resolved on a winning spin.
// `won = true` means the player doubled (saldo += amount, house -= amount).
// `won = false` means the player lost (saldo -= amount, house += amount).
model SlotGambleRound {
  id        String   @id @default(cuid())
  userId    String
  spinId    String? // SlotSpin that seeded this gamble chain (nullable for safety)
  amount    Float // amount at risk on this round
  won       Boolean
  round     Int // 1..MAX_GAMBLE_ROUNDS within the chain
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id])
  spin SlotSpin? @relation(fields: [spinId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// Wheel of Henricus — fixed-odds lottery game where each spin (25 TC) picks a
// random guildmate (excluding self). When any in-frame assigned alias dies in
// real life (TibiaData polled every minute), every matching spin pays a flat
// 500 TC from the house. Multiple winners each get the full 500.
model HenricusFrame {
  id              String              @id @default(cuid())
  status          HenricusFrameStatus @default(ACTIVE)
  totalSpinCount  Int                 @default(0)
  totalPayout     Float               @default(0)
  deadAlias       String?
  deadAtServer    DateTime?
  deadAtTibia     DateTime?
  deathLevel      Int?
  deathReason     String?
  createdAt       DateTime            @default(now())
  settledAt       DateTime?

  spins HenricusSpin[]

  @@index([status])
  @@index([createdAt])
}

model HenricusSpin {
  id             String   @id @default(cuid())
  frameId        String
  spinnerUserId  String
  assignedUserId String
  // Snapshot of the assigned user's alias at spin time so death-tracking
  // is stable even if the user later renames their character.
  assignedAlias  String
  stake          Float    @default(25)
  rerollCount    Int      @default(0)
  payout         Float    @default(0)
  isWinner       Boolean  @default(false)
  currency       Currency @default(TIBIA_COINS)
  createdAt      DateTime @default(now())

  frame    HenricusFrame @relation(fields: [frameId], references: [id])
  spinner  User          @relation("HenricusSpinner", fields: [spinnerUserId], references: [id])
  assigned User          @relation("HenricusAssigned", fields: [assignedUserId], references: [id])

  @@index([frameId])
  @@index([frameId, spinnerUserId])
  @@index([assignedAlias])
  @@index([spinnerUserId])
  @@index([createdAt])
}
