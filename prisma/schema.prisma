generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum Pick {
  HOME
  AWAY
  DRAW
  HOME_DRAW
  AWAY_DRAW
}

enum Currency {
  GOLD
  TIBIA_COINS
}

enum PvPBetStatus {
  OPEN
  MATCHED
  WON_CREATOR
  WON_ACCEPTOR
  CANCELLED
  VOID
}

enum TicketStatus {
  PENDING
  WON
  LOST
  VOID
}

enum SelectionResult {
  PENDING
  WON
  LOST
  VOID
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String    @id @default(cuid())
  name            String?
  alias           String?   @unique
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now())
  saldoGold       Float     @default(0)
  saldoTibiaCoins Float     @default(0)

  // Double-or-nothing gamble state (slots). activeGambleAmount is the TC
  // currently "in play" on the gamble; 0 means no gamble pending.
  activeGambleAmount Float @default(0)
  activeGambleRounds Int   @default(0)

  // Free-spin bonus state (slots). activeFreeSpins > 0 means the user is in a
  // bonus round; freeSpinStake is the locked stake used for each free spin.
  activeFreeSpins Int   @default(0)
  freeSpinStake   Float @default(0)

  accounts     Account[]
  sessions     Session[]
  createdBets  PvPBet[]   @relation("BetCreator")
  acceptedBets PvPBet[]   @relation("BetAcceptor")
  tickets      Ticket[]
  slotSpins    SlotSpin[]
}

model Sport {
  id     String  @id @default(cuid())
  key    String  @unique // e.g. "basketball_nba"
  name   String // e.g. "NBA"
  active Boolean @default(true)
  events Event[]
}

model Event {
  id            String      @id @default(cuid())
  apiEventId    String      @unique
  sportId       String
  homeTeam      String
  awayTeam      String
  commenceTime  DateTime
  homeScore     Int?
  awayScore     Int?
  liveHomeScore Int?
  liveAwayScore Int?
  liveClock     String?
  status        EventStatus @default(UPCOMING)
  completedAt   DateTime?
  espnEventId   String?     @unique
  homeLogoUrl   String?
  awayLogoUrl   String?
  updatedAt     DateTime    @updatedAt

  sport      Sport             @relation(fields: [sportId], references: [id])
  odds       OddsSnapshot[]
  pvpBets    PvPBet[]
  selections TicketSelection[]

  @@index([status])
  @@index([commenceTime])
}

model OddsSnapshot {
  id           String   @id @default(cuid())
  eventId      String
  homeOdds     Float
  awayOdds     Float
  drawOdds     Float?
  homeDrawOdds Float?
  awayDrawOdds Float?
  bookmaker    String
  fetchedAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId, fetchedAt])
}

model PvPBet {
  id           String       @id @default(cuid())
  creatorId    String
  acceptorId   String?
  eventId      String
  pick         Pick
  amount       Float
  odds         Float
  joinerPick   Pick?
  joinerAmount Float?
  currency     Currency     @default(GOLD)
  status       PvPBetStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  settledAt    DateTime?

  creator  User  @relation("BetCreator", fields: [creatorId], references: [id])
  acceptor User? @relation("BetAcceptor", fields: [acceptorId], references: [id])
  event    Event @relation(fields: [eventId], references: [id])

  @@index([status])
  @@index([eventId])
}

model Ticket {
  id              String       @id @default(cuid())
  userId          String
  totalOdds       Float
  amount          Float
  currency        Currency     @default(GOLD)
  potentialPayout Float
  status          TicketStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  settledAt       DateTime?

  user       User              @relation(fields: [userId], references: [id])
  selections TicketSelection[]

  @@index([status])
  @@index([userId])
}

model TicketSelection {
  id       String          @id @default(cuid())
  ticketId String
  eventId  String
  pick     Pick
  odds     Float
  result   SelectionResult @default(PENDING)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id])

  @@index([ticketId])
  @@index([eventId])
}

model SlotSpin {
  id         String   @id @default(cuid())
  userId     String
  currency   Currency
  stake      Float
  payout     Float    @default(0) // 0 on loss
  symbols    String // e.g. "dragon,dragon,snake"
  multiplier Float    @default(0) // payout / stake; convenience for analytics
  isFreeSpin Boolean  @default(false) // true if this spin was awarded via the joker bonus
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([multiplier])
}
