# Database
DATABASE_URL="postgresql://user:password@localhost:5432/banterboys"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Discord OAuth
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# The Odds API
ODDS_API_KEY=""

# Cron secret (protect cron endpoints)
CRON_SECRET=""

# Wheel of Henricus death-poll schedule (default: every minute)
CRON_HENRICUS_SCHEDULE="* * * * *"

# Wheel of Henricus economy (non-negative integers; 0 = free spins / no payout;
# defaults: 25 / 500 TC if unset, empty, or invalid)
HENRICUS_SPIN_STAKE="25"
HENRICUS_SPIN_PAYOUT="500"

# Admin emails (restricts /admin route). Comma-separated for multiple.
ADMIN_EMAIL=""

# Discord webhook for bet notifications (optional)
DISCORD_WEBHOOK_URL=""
